{
  "manifest_version": 3,
  "name": "Pack Opening voor SOMtoday",
  "version": "0.2.5",
  "description": "Open zichtbare cijfers met een lokale pack opening. Cijfers zijn vooraf bepaald.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://leerling.somtoday.nl/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pack Opening voor SOMtoday"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leerling.somtoday.nl/*"
      ],
      "exclude_matches": [
        "https://leerling.somtoday.nl/cijfers/vakgemiddelden*"
      ],
      "css": [
        "shield.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://leerling.somtoday.nl/*"
      ],
      "exclude_matches": [
        "https://leerling.somtoday.nl/cijfers/vakgemiddelden*"
      ],
      "js": [
        "observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/case-opening.mp3",
        "assets/high-grade-accent.mp3"
      ],
      "matches": [
        "https://leerling.somtoday.nl/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
