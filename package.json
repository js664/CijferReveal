{
  "name": "pack-opening-voor-somtoday",
  "version": "0.2.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs --firefox",
    "build:snapshot": "node scripts/build.mjs --snapshot",
    "build:dev": "node scripts/build.mjs --dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "node scripts/validate.mjs",
    "audit": "npm audit --omit=dev",
    "check:secrets": "node scripts/check-secrets.mjs",
    "build:magister": "npm --prefix magister run build",
    "test:magister": "npm --prefix magister test",
    "validate:magister": "npm --prefix magister run validate",
    "test:e2e:magister": "npm --prefix magister run test:e2e"
  },
  "dependencies": {
    "border-beam": "^1.4.1",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.36.0",
    "fflate": "^0.8.3",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
